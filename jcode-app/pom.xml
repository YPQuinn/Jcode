<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>site.pplee</groupId>
        <artifactId>Jcode</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>jcode-app</artifactId>
    <description>In-process managed sessions and command coordination for Jcode.</description>
    <dependencies>
        <dependency>
            <groupId>site.pplee</groupId>
            <artifactId>jcode-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>site.pplee</groupId>
            <artifactId>coding-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>site.pplee</groupId>
            <artifactId>ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-boundaries</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>site.pplee:agent-core</exclude>
                                        <exclude>site.pplee:ai-providers</exclude>
                                    </excludes>
                                    <message>jcode-app must not depend directly on agent-core or provider adapters.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

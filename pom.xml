<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>site.pplee</groupId>
    <artifactId>Jcode</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>ai</module>
        <module>ai-providers</module>
        <module>agent-core</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.46</lombok.version>
        <jackson.version>2.18.2</jackson.version>
        <junit.version>5.11.4</junit.version>
        <maven.surefire.version>3.5.2</maven.surefire.version>
        <maven.enforcer.version>3.5.0</maven.enforcer.version>
        <!-- Jcode-internal artifacts (versioned from the reactor) -->
        <jcode.ai.version>${project.version}</jcode.ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Jcode-internal modules. Declared here so child modules reference
              them by groupId:artifactId without repeating the version. The
              reactor build order (ai -> ai-providers -> agent-core) is
              fixed in <modules>; the dependency graph itself (ai knows nothing
              of agent-core; agent-core depends only on ai; ai-providers
              depends only on ai) is enforced by maven-enforcer
              bannedDependencies below.
            -->
            <dependency>
                <groupId>site.pplee</groupId>
                <artifactId>ai</artifactId>
                <version>${jcode.ai.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven.enforcer.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!--
          Module-boundary guard. The Jcode dependency graph must be acyclic
          and point only from product layer to core layer:
            ai           has NO Jcode-internal dependency
            ai-providers depends ONLY on ai
            agent-core   depends ONLY on ai
          Future modules (coding-agent, server, tui) will be added to the
          excludes as they are created. Concrete provider implementations live
          inside the shared ai-providers module (one sub-package per provider),
          so the provider forward guard is the ai-providers artifact itself.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-boundaries</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- ai must not depend on agent-core (or any other Jcode module) -->
                                        <exclude>site.pplee:agent-core</exclude>
                                        <!-- agent-core must not depend on the shared providers module / product modules (forward guard; product modules do not exist yet) -->
                                        <exclude>site.pplee:ai-providers</exclude>
                                        <exclude>site.pplee:coding-agent</exclude>
                                        <exclude>site.pplee:server</exclude>
                                        <exclude>site.pplee:tui</exclude>
                                    </excludes>
                                    <message>
                                        Jcode module-boundary violation: this module must not depend on the excluded artifact.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
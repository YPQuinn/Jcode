<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>site.pplee</groupId>
        <artifactId>Jcode</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>coding-agent</artifactId>

    <description>
        Headless coding-product runtime. Composes the provider-neutral model
        protocol and Agent runtime with coding prompts, local tools, product
        state, results, and events. UI and provider wire protocols stay out of
        this module.
    </description>

    <dependencies>
        <dependency>
            <groupId>site.pplee</groupId>
            <artifactId>ai</artifactId>
        </dependency>
        <dependency>
            <groupId>site.pplee</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>site.pplee</groupId>
            <artifactId>ai-providers</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-boundaries</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>site.pplee:server</exclude>
                                        <exclude>site.pplee:tui</exclude>
                                    </excludes>
                                    <message>coding-agent may depend only on ai, agent-core, and ai-providers among Jcode modules.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>local-tools-smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-local-tools-smoke-executables</id>
                                <goals><goal>enforce</goal></goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>jcode.test.bash</property>
                                            <regex>/.+</regex>
                                            <message>
                                                local-tools-smoke requires
                                                -Djcode.test.bash=/absolute/path/to/bash
                                            </message>
                                        </requireProperty>
                                        <requireProperty>
                                            <property>jcode.test.rg</property>
                                            <regex>/.+</regex>
                                            <message>
                                                local-tools-smoke requires
                                                -Djcode.test.rg=/absolute/path/to/rg
                                            </message>
                                        </requireProperty>
                                        <requireProperty>
                                            <property>jcode.test.fd</property>
                                            <regex>/.+</regex>
                                            <message>
                                                local-tools-smoke requires
                                                -Djcode.test.fd=/absolute/path/to/fd
                                            </message>
                                        </requireProperty>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <jcode.test.localToolsStrict>true</jcode.test.localToolsStrict>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
